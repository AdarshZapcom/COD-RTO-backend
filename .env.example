# Supabase Postgres connection string (required for ticketing.py,
# supabase_setup.py, and the /tickets endpoints). Direct connection
# string from Supabase project settings -> Database -> Connection string.
SUPABASE_DB_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# OpenAI API key (optional). Enables LLM-written narratives
# (narrative_source: "llm"). If unset, or the call fails/times out,
# investigation_agent.py falls back to a deterministic template
# narrative built from the same evidence - nothing about the decision
# itself changes.
OPENAI_API_KEY=sk-...

# Optional override for the OpenAI model used for narratives.
# INVESTIGATION_AGENT_MODEL=gpt-4o-mini
